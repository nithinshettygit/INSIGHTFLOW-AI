# InsightFlow AI — environment template
# Copy to .env and fill values as phases require them.
# Never commit .env.

# Application
APP_NAME=InsightFlow AI
APP_ENV=development
DEBUG=true

# Backend API (Phase 1+)
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# LLM — Groq (Phase 4 intent + later RAG/insight)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Intent detection (Phase 4)
# llm = Groq via LangGraph (falls back to rules if key missing/errors)
# rules = offline keyword classifier only
INTENT_PROVIDER=llm
INTENT_TEMPERATURE=0.0

# Data paths (Phase 2+)
UPLOAD_DIR=backend/data/uploads
PROCESSED_DIR=backend/data/processed
MODEL_DIR=backend/models
MAX_UPLOAD_SIZE_MB=25

# Database — SQLite (later phases)
DATABASE_URL=sqlite:///./backend/data/insightflow.db
