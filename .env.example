# InsightFlow AI — environment template
# Copy to .env and fill values as phases require them.
# Never commit .env.

# Application
APP_NAME=InsightFlow AI
APP_ENV=development
DEBUG=true

# Backend API (Phase 1+)
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
LOG_LEVEL=INFO
# Comma-separated frontend origins (add your Netlify URL in production)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# LLM — Groq (Phase 4 intent + Phase 8 RAG + Phase 10 insight)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Intent detection (Phase 4, always Groq via LangGraph)
INTENT_TEMPERATURE=0.0

# Data paths (Phase 2+)
UPLOAD_DIR=backend/data/uploads
PROCESSED_DIR=backend/data/processed
MODEL_DIR=backend/models
RAG_DIR=backend/data/rag
MAX_UPLOAD_SIZE_MB=25

# RAG (Phase 8)
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=4
RAG_EMBEDDING_DIM=384
RAG_TEMPERATURE=0.0

# ML (Phase 9)
ML_DEFAULT_HORIZON=7
ML_DEFAULT_CLUSTERS=3
ML_ANOMALY_CONTAMINATION=0.05
ML_RANDOM_STATE=42

# Insight (Phase 10)
INSIGHT_TEMPERATURE=0.1

# Database — SQLite (later phases)
DATABASE_URL=sqlite:///./backend/data/insightflow.db
